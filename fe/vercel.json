{
    "routes": [
        {
            "src": "^/api/health$",
            "dest": "https://func-geosupplyguard-ts.azurewebsites.net/health"
        },
        {
            "src": "^/api/(.*)$",
            "dest": "https://func-geosupplyguard-ts.azurewebsites.net/api/$1"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "^/(.*)$",
            "dest": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/index.html",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
            ]
        },
        {
            "source": "/api/:path*",
            "headers": [
                { "key": "Access-Control-Allow-Origin", "value": "*" },
                { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
                { "key": "Access-Control-Allow-Headers", "value": "Authorization, Content-Type" }
            ]
        }
    ]
}