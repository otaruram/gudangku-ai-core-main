{
    "rewrites": [
        {
            "source": "/api/health",
            "destination": "https://func-geosupplyguard-ts.azurewebsites.net/health"
        },
        {
            "source": "/api/:path*",
            "destination": "https://func-geosupplyguard-ts.azurewebsites.net/api/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/api/:path*",
            "headers": [
                { "key": "Access-Control-Allow-Origin", "value": "*" },
                { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
                { "key": "Access-Control-Allow-Headers", "value": "Authorization, Content-Type" }
            ]
        }
    ]
}